# --- Application ---
# development | production | test
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for CORS (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Preferred: a single connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store_rating
# Alternative: discrete variables (used only when DATABASE_URL is not set).
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=store_rating

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY=1d

# --- Default admin (used by `npm run seed`) ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
